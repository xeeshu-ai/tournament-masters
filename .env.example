# ─── Tournvia Admin Panel — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file — it is already in .gitignore.

# ── Supabase Project ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://heudglgxvgattjhfydut.supabase.co

# Anon key — safe to use client-side (used only for admin auth login/logout)
# Get from: Supabase Dashboard → Project Settings → API → anon (public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — bypasses RLS, used for ALL data queries in admin panel
# ⚠️  KEEP THIS SECRET — never expose in the public (tournament) app
# Get from: Supabase Dashboard → Project Settings → API → service_role (secret)
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here
